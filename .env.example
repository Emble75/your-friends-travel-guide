# Vorlage -- echte Werte gehoeren in .env, die NICHT eingecheckt wird.

# Supabase (oeffentlich, durch Row-Level-Security geschuetzt)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Serverseitig -- niemals mit VITE_ praefixen, sonst landen sie im Browser
APP_SUPABASE_URL=
APP_SUPABASE_SERVICE_ROLE_KEY=

# Places-API: ENTWEDER ein eigener Google-Schluessel (bevorzugt) ...
GOOGLE_PLACES_API_KEY=
# ... ODER Lovables Gateway
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Oeffentliche Adresse der App -- fuer geteilte Links
VITE_APP_URL=
